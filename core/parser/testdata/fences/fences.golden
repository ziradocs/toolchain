section "Lectura de las versiones anteriores"
  code "js" line 23: "sin cierre de cuatro"
  text line 27: "<h2 id=\"sigue-siendo-encabezado\">Sigue siendo encabezado</h2>"
  code "ts" line 29: "const a = 1"
